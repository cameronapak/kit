{
  "name": "freedom-stack",
  "type": "module",
  "version": "1.0.2",
  "scripts": {
    "dev": "astro dev",
    "dev:remote": "astro dev --mode remote",
    "dev:host": "astro dev --host",
    "update-packages": "npx npm-check-updates -u",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "db:seed": "node db/seed.ts",
    "test": "node --test db/*.test.ts src/libs/*.test.ts && bun test tests/ownership.test.mjs",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.14.1",
    "@alpinejs/intersect": "^3.14.1",
    "@alpinejs/mask": "^3.14.1",
    "@alpinejs/persist": "^3.14.1",
    "@astrojs/alpinejs": "1.0.0",
    "@astrojs/check": "0.9.12",
    "@astrojs/netlify": "8.2.14",
    "@astrojs/rss": "4.0.19",
    "@clerk/astro": "^4.1.27",
    "@cloudinary-util/url-loader": "^6.3.2",
    "@iconify-json/lucide": "^1.2.3",
    "@iconify-json/lucide-lab": "^1.2.0",
    "@libsql/client": "^0.18.0",
    "@netlify/cache": "^4.2.1",
    "alpinejs": "^3.14.1",
    "astro": "7.4.13",
    "astro-iconify": "^1.2.0",
    "astro-seo": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "errore": "^0.9.0",
    "groq-sdk": "^1.6.0",
    "htmlparser2": "^12.0.0",
    "htmx.org": "2.0.11",
    "isbot": "^5.2.3",
    "trix": "^2.1.19",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/alpinejs": "^3.13.10",
    "autoprefixer": "^10.6.2",
    "daisyui": "^4.12.10",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.6"
  },
  "private": false,
  "description": "A modern stack for building Christian tech products in public, created with Astro",
  "author": "Cameron Pak",
  "homepage": "https://kit.faith.tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/cameronapak/kit"
  },
  "bugs": {
    "url": "https://github.com/cameronapak/kit/issues"
  },
  "keywords": [
    "astro",
    "christian",
    "faith",
    "tech",
    "blog",
    "cms",
    "alpinejs",
    "htmx",
    "tailwindcss"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  }
}
